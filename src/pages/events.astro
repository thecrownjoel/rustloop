---
import Base from '../layouts/Base.astro';

const events = [
  {
    title: '[TODO: Event title]',
    date: 'TBD',
    time: 'TBD',
    location: 'Youngstown, OH',
    description: '[TODO: Event description placeholder]',
  },
  {
    title: '[TODO: Event title]',
    date: 'TBD',
    time: 'TBD',
    location: 'Cleveland, OH',
    description: '[TODO: Event description placeholder]',
  },
  {
    title: '[TODO: Event title]',
    date: 'TBD',
    time: 'TBD',
    location: 'Pittsburgh, PA',
    description: '[TODO: Event description placeholder]',
  },
];
---

<Base
  title="Events"
  description="Upcoming RustLoop meetups and events across Youngstown, Cleveland, and Pittsburgh."
>
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-flame">Events</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-flame sm:text-5xl">
        Upcoming Meetups
      </h1>
      <p class="mt-4 text-lg text-gold">
        [TODO: copy — to be written. Events page intro.]
      </p>

      <div class="mt-12 space-y-6">
        {events.map((event) => (
          <div class="ember-glow rounded-xl border border-dark-600 bg-dark-900/50 p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h2 class="text-xl font-bold text-flame">{event.title}</h2>
                <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-gold-600">
                  <span>{event.date}</span>
                  <span aria-hidden="true">&middot;</span>
                  <span>{event.time}</span>
                  <span aria-hidden="true">&middot;</span>
                  <span class="text-flame">{event.location}</span>
                </div>
                <p class="mt-3 text-gold">{event.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Past events note -->
      <div class="mt-16 rounded-xl border border-dark-700 bg-dark-900/30 p-6 text-center">
        <p class="text-gold-600">
          [TODO: copy — to be written. Note about past events or how to stay informed about future ones.]
        </p>
      </div>
    </div>
  </section>
</Base>
