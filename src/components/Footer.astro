---
const year = new Date().getFullYear();
---

<footer class="border-t border-steel-800 bg-steel-950">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="text-xl font-bold tracking-tight text-steel-50">
          <span class="text-ember">Rust</span><span>Loop</span>
        </a>
        <p class="mt-3 text-sm text-steel-400">
          AI/ML community across Youngstown, Cleveland, and Pittsburgh.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-steel-400">Navigate</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/" class="text-sm text-steel-300 transition-colors hover:text-ember">Home</a></li>
          <li><a href="/about" class="text-sm text-steel-300 transition-colors hover:text-ember">About</a></li>
          <li><a href="/blog" class="text-sm text-steel-300 transition-colors hover:text-ember">Blog</a></li>
          <li><a href="/events" class="text-sm text-steel-300 transition-colors hover:text-ember">Events</a></li>
        </ul>
      </div>

      <!-- Cities -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-steel-400">Cities</h3>
        <ul class="mt-3 space-y-2">
          <li class="text-sm text-steel-300">Youngstown, OH</li>
          <li class="text-sm text-steel-300">Cleveland, OH</li>
          <li class="text-sm text-steel-300">Pittsburgh, PA</li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-steel-400">Connect</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="mailto:hello@rustloop.ai" class="text-sm text-steel-300 transition-colors hover:text-ember">hello@rustloop.ai</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-steel-800 pt-6 text-center text-sm text-steel-500">
      <p>&copy; {year} RustLoop. From the ashes of rust to artificial intelligence.</p>
    </div>
  </div>
</footer>
