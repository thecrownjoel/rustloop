---
const year = new Date().getFullYear();
---

<footer class="border-t border-dark-700 bg-dark-950">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/">
          <img src="/rustloop-logo.png" alt="RustLoop" class="h-8 w-auto" />
        </a>
        <p class="mt-3 text-sm text-gold-600">
          AI/ML community across Youngstown, Cleveland, and Pittsburgh.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-600">Navigate</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/" class="text-sm text-gold transition-colors hover:text-flame">Home</a></li>
          <li><a href="/about" class="text-sm text-gold transition-colors hover:text-flame">About</a></li>
          <li><a href="/blog" class="text-sm text-gold transition-colors hover:text-flame">Blog</a></li>
          <li><a href="/events" class="text-sm text-gold transition-colors hover:text-flame">Events</a></li>
        </ul>
      </div>

      <!-- Cities -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-600">Cities</h3>
        <ul class="mt-3 space-y-2">
          <li class="text-sm text-gold">Youngstown, OH</li>
          <li class="text-sm text-gold">Cleveland, OH</li>
          <li class="text-sm text-gold">Pittsburgh, PA</li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-600">Connect</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="mailto:hello@rustloop.ai" class="text-sm text-gold transition-colors hover:text-flame">hello@rustloop.ai</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-dark-700 pt-6 text-center text-sm text-gold-700">
      <p>&copy; {year} RustLoop. From the ashes of rust to artificial intelligence.</p>
    </div>
  </div>
</footer>
