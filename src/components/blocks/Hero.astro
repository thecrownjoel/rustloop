---
interface Props {
	node: {
		headline: string;
		subheadline?: string;
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
		image?: { url: string; alt?: string };
		centered?: boolean;
		cities?: string;
	};
}

const { node } = Astro.props;
const { headline, subheadline, image, centered } = node;

const primaryCta =
	node.primaryCtaLabel && node.primaryCtaUrl
		? { label: node.primaryCtaLabel, url: node.primaryCtaUrl }
		: undefined;
const secondaryCta =
	node.secondaryCtaLabel && node.secondaryCtaUrl
		? { label: node.secondaryCtaLabel, url: node.secondaryCtaUrl }
		: undefined;
---

<section class:list={["hero", { "hero-centered": centered, "hero-with-image": !!image }]}>
	<div class="hero-gradient" aria-hidden="true"></div>
	<div class="hero-inner">
		<div class="hero-content">
			{node.cities && (
				<p class="hero-cities">{node.cities}</p>
			)}
			<h1 class="hero-headline" set:html={headline} />
			{subheadline && <p class="hero-subheadline">{subheadline}</p>}
			{(primaryCta || secondaryCta) && (
				<div class="hero-actions">
					{primaryCta && (
						<a href={primaryCta.url} class="btn btn-primary btn-lg">
							{primaryCta.label}
						</a>
					)}
					{secondaryCta && (
						<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
							{secondaryCta.label}
						</a>
					)}
				</div>
			)}
		</div>
		{image && (
			<div class="hero-image">
				<img src={image.url} alt={image.alt || ""} loading="eager" />
			</div>
		)}
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
	}

	.hero-gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(245, 121, 59, 0.06) 0%, #111111 100%);
		pointer-events: none;
	}

	.hero-inner {
		position: relative;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-5xl) var(--spacing-lg);
	}

	.hero-centered .hero-inner {
		text-align: center;
		max-width: var(--max-width);
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		max-width: 800px;
	}

	.hero-centered .hero-content {
		max-width: 100%;
		margin: 0 auto;
	}

	.hero-cities {
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: #f5793b;
	}

	.hero-headline {
		font-size: var(--font-size-5xl);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: #f5793b;
	}

	.hero-subheadline {
		font-size: var(--font-size-lg);
		line-height: 1.7;
		color: #ffbd39;
		max-width: 720px;
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
		padding-top: var(--spacing-md);
	}

	.hero-image {
		position: relative;
		margin-top: var(--spacing-2xl);
	}

	.hero-image img {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xl);
	}

	@media (max-width: 1024px) {
		.hero-inner {
			padding: var(--spacing-3xl) var(--spacing-lg);
		}

		.hero-headline {
			font-size: var(--font-size-4xl);
		}

		.hero-subheadline {
			font-size: var(--font-size-base);
		}
	}
</style>
